{
  "name": "@pb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "bot": "tsx src/bot/run.ts",
    "bot:check": "tsx src/bot/check.ts",
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import fs from 'node:fs'; fs.mkdirSync('dist/db',{recursive:true}); fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.0.2",
    "@maxhub/max-bot-api": "^1.0.1",
    "@pb/shared": "workspace:*",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "pg": "^8.16.0",
    "undici": "^8.11.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  }
}
