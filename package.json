{
  "name": "podzemnye-bogatstva",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pb/web --filter @pb/api run dev",
    "dev:web": "pnpm --filter @pb/web dev",
    "dev:api": "pnpm --filter @pb/api dev",
    "bot": "pnpm --filter @pb/api bot",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @pb/api db:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
